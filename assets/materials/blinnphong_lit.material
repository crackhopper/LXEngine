shader: blinnphong_0

variants:
  USE_LIGHTING: true

variantRules:
  - requires: [USE_NORMAL_MAP]
    depends: [USE_LIGHTING, USE_UV]
  - requires: [USE_SKINNING]
    depends: [USE_LIGHTING]

defaultTechnique: Forward
techniques:
  Forward:
    passes:
      Forward:
        renderState:
          cullMode: Back
          depthTest: true
          depthWrite: true
      Shadow:
        shader: shadow_depth_only
        renderState:
          cullMode: None
          depthTest: true
          depthWrite: true
      OfflineRayTrace:
        shader: offline_primary_ray
        stage: compute

parameters:
  MaterialUBO.baseColor: [0.8, 0.8, 0.8]
  MaterialUBO.shininess: 12.0
  MaterialUBO.specularIntensity: 1.0
  MaterialUBO.ambientIntensity: 0.0
  MaterialUBO.enableAlbedo: 0
  MaterialUBO.enableNormal: 0
  MaterialUBO.debugShadowMode: 0
