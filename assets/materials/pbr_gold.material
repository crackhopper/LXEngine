shader: pbr

variants:
  HAS_METALLIC_ROUGHNESS: false
  HAS_NORMAL_MAP: false
  HAS_AO_MAP: false
  HAS_EMISSIVE_MAP: false
  HAS_IBL: true

variantRules:
  - requires: [HAS_NORMAL_MAP]
    depends: [HAS_METALLIC_ROUGHNESS]

defaultTechnique: Forward
techniques:
  Forward:
    passes:
      Forward:
        renderState:
          cullMode: Back
          depthTest: true
          depthWrite: true

parameters:
  MaterialUBO.baseColorFactor: [1.0, 0.766, 0.336, 1.0]
  MaterialUBO.metallicFactor: 1.0
  MaterialUBO.roughnessFactor: 0.25
  MaterialUBO.ao: 1.0

resources:
  albedoMap: white
