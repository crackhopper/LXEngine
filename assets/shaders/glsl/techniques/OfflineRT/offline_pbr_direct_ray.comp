#version 450

#extension GL_EXT_nonuniform_qualifier : require

#include "common/pbr.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

const uint SCENE_ATTRIBUTE_NORMAL0 = 1u;
const uint SCENE_ATTRIBUTE_UV0 = 2u;
const uint SCENE_ATTRIBUTE_TANGENT0 = 3u;

struct lxSceneMeshRecord {
  uint vertexOffset;
  uint indexOffset;
  uint indexCount;
  uint geometryIndex;
  uint attributeStreamOffset;
  uint attributeStreamCount;
  uint reserved0;
  uint reserved1;
};

struct lxSceneAttributeStreamRecord {
  uint semantic;
  uint valueOffset;
  uint valueCount;
  uint components;
};

struct lxScenePrimitiveRecord {
  uint indexOffset;
  uint meshIndex;
  uint materialIndex;
  uint objectIndex;
};

struct lxSceneObjectRecord {
  mat4 objectToWorld;
  mat4 worldToObject;
  vec4 boundsMin;
  vec4 boundsMax;
  uvec4 flags;
};

struct lxSceneMaterialRecord {
  vec4 baseColor;
  vec4 pbrParams;
  vec4 emissive;
  vec4 clearcoatParams;
  uint baseColorTexture;
  uint normalTexture;
  uint metallicRoughnessTexture;
  uint aoTexture;
  uint emissiveTexture;
  uint flags;
  uint reserved0;
  uint reserved1;
};

struct lxSceneBvhNode {
  vec4 boundsMinLeftFirst;
  vec4 boundsMaxTriCount;
};

layout(std430, binding = 0) readonly buffer ScenePositions {
  vec4 positions[];
};

layout(std430, binding = 1) readonly buffer SceneAttributeStreams {
  lxSceneAttributeStreamRecord attributeStreams[];
};

layout(std430, binding = 2) readonly buffer SceneAttributeValues {
  vec4 attributeValues[];
};

layout(std430, binding = 3) readonly buffer SceneIndices {
  uint indices[];
};

layout(std430, binding = 4) readonly buffer SceneMeshes {
  lxSceneMeshRecord meshes[];
};

layout(std430, binding = 5) readonly buffer ScenePrimitives {
  lxScenePrimitiveRecord primitives[];
};

layout(std430, binding = 6) readonly buffer SceneObjects {
  lxSceneObjectRecord objects[];
};

layout(std430, binding = 7) readonly buffer SceneMaterials {
  lxSceneMaterialRecord materials[];
};

layout(std430, binding = 8) readonly buffer SceneBvhNodes {
  lxSceneBvhNode bvhNodes[];
};

layout(std430, binding = 9) readonly buffer SceneFrameParams {
  vec4 eye;
  vec4 cameraRight;
  vec4 cameraUp;
  vec4 cameraForward;
  vec4 lightDirectionIntensity;
  vec4 lightColorEnvironment;
  vec4 backgroundColor;
  vec4 reserved;
  uint width;
  uint height;
  uint samples;
  uint seed;
  uint primitiveCount;
  uint bvhNodeCount;
  uint materialCount;
  uint maxBounce;
  uint shadowsEnabled;
  uint compareMode;
  uint integrator;
  uint frameIndex;
} params;

layout(std430, binding = 10) writeonly buffer OutputPixels {
  vec4 pixels[];
};

layout(set = 0, binding = 11) uniform sampler2D SceneTextures[256];

const uint BVH_LEAF_NODE_FLAG = 0x80000000u;
const uint INVALID_TEXTURE_INDEX = 0xffffffffu;
const uint SCENE_TEXTURE_COUNT = 256u;
const uint MATERIAL_CULL_MODE_MASK = 0x3u;
const uint MATERIAL_CULL_MODE_NONE = 0u;
const uint MATERIAL_CULL_MODE_FRONT = 1u;
const uint MATERIAL_CULL_MODE_BACK = 2u;

uint wangHash(uint value) {
  value = (value ^ 61u) ^ (value >> 16u);
  value *= 9u;
  value = value ^ (value >> 4u);
  value *= 0x27d4eb2du;
  value = value ^ (value >> 15u);
  return value;
}

float random01(uint seed) {
  return float(wangHash(seed) & 0x00ffffffu) / float(0x01000000u);
}

vec3 environmentColor(vec3 dir) {
  return params.backgroundColor.rgb;
}

struct HitAttributes {
  vec3 normal;
  vec3 tangent;
  float tangentSign;
  vec2 uv;
  uint materialIndex;
};

vec3 transformPoint(mat4 m, vec3 p) {
  vec4 value = m * vec4(p, 1.0);
  return value.xyz / max(value.w, 1.0e-8);
}

vec4 readMeshAttribute(lxSceneMeshRecord mesh, uint semantic, uint vertexIndex,
                       vec4 fallback) {
  for (uint i = 0u; i < mesh.attributeStreamCount; ++i) {
    lxSceneAttributeStreamRecord stream =
        attributeStreams[mesh.attributeStreamOffset + i];
    if (stream.semantic != semantic || vertexIndex < mesh.vertexOffset ||
        vertexIndex >= mesh.vertexOffset + stream.valueCount) {
      continue;
    }
    return attributeValues[stream.valueOffset + vertexIndex - mesh.vertexOffset];
  }
  return fallback;
}

bool shouldCullRayHit(uint materialIndex, bool frontFacing) {
  if (params.materialCount == 0u) {
    return false;
  }
  lxSceneMaterialRecord material =
      materials[min(materialIndex, params.materialCount - 1u)];
  uint cullMode = material.flags & MATERIAL_CULL_MODE_MASK;
  if (cullMode == MATERIAL_CULL_MODE_BACK) {
    return !frontFacing;
  }
  if (cullMode == MATERIAL_CULL_MODE_FRONT) {
    return frontFacing;
  }
  return false;
}

bool intersectPrimitive(vec3 origin, vec3 dir, lxScenePrimitiveRecord primitive,
                        out float t, out HitAttributes attributes) {
  lxSceneObjectRecord object = objects[primitive.objectIndex];
  lxSceneMeshRecord mesh = meshes[primitive.meshIndex];
  uint i0 = indices[primitive.indexOffset + 0u];
  uint i1 = indices[primitive.indexOffset + 1u];
  uint i2 = indices[primitive.indexOffset + 2u];
  vec4 p0 = positions[i0];
  vec4 p1 = positions[i1];
  vec4 p2 = positions[i2];
  vec3 v0 = transformPoint(object.objectToWorld, p0.xyz);
  vec3 v1 = transformPoint(object.objectToWorld, p1.xyz);
  vec3 v2 = transformPoint(object.objectToWorld, p2.xyz);
  vec3 e1 = v1 - v0;
  vec3 e2 = v2 - v0;
  vec3 p = cross(dir, e2);
  float det = dot(e1, p);
  if (abs(det) < 1e-7) {
    return false;
  }
  if (shouldCullRayHit(primitive.materialIndex, det > 0.0)) {
    return false;
  }
  float invDet = 1.0 / det;
  vec3 tv = origin - v0;
  float u = dot(tv, p) * invDet;
  if (u < 0.0 || u > 1.0) {
    return false;
  }
  vec3 q = cross(tv, e1);
  float v = dot(dir, q) * invDet;
  if (v < 0.0 || u + v > 1.0) {
    return false;
  }
  t = dot(e2, q) * invDet;
  if (t <= 0.0005) {
    return false;
  }

  const float w = 1.0 - u - v;
  vec4 n0 = readMeshAttribute(mesh, SCENE_ATTRIBUTE_NORMAL0, i0,
                              vec4(0.0, 0.0, 1.0, 0.0));
  vec4 n1 = readMeshAttribute(mesh, SCENE_ATTRIBUTE_NORMAL0, i1,
                              vec4(0.0, 0.0, 1.0, 0.0));
  vec4 n2 = readMeshAttribute(mesh, SCENE_ATTRIBUTE_NORMAL0, i2,
                              vec4(0.0, 0.0, 1.0, 0.0));
  vec4 uv0 = readMeshAttribute(mesh, SCENE_ATTRIBUTE_UV0, i0,
                               vec4(0.0, 0.0, 0.0, 0.0));
  vec4 uv1 = readMeshAttribute(mesh, SCENE_ATTRIBUTE_UV0, i1,
                               vec4(0.0, 0.0, 0.0, 0.0));
  vec4 uv2 = readMeshAttribute(mesh, SCENE_ATTRIBUTE_UV0, i2,
                               vec4(0.0, 0.0, 0.0, 0.0));
  vec4 t0 = readMeshAttribute(mesh, SCENE_ATTRIBUTE_TANGENT0, i0,
                              vec4(1.0, 0.0, 0.0, 1.0));
  vec4 t1 = readMeshAttribute(mesh, SCENE_ATTRIBUTE_TANGENT0, i1,
                              vec4(1.0, 0.0, 0.0, 1.0));
  vec4 t2 = readMeshAttribute(mesh, SCENE_ATTRIBUTE_TANGENT0, i2,
                              vec4(1.0, 0.0, 0.0, 1.0));
  vec3 localNormal =
      normalize(n0.xyz * w + n1.xyz * u + n2.xyz * v);
  vec3 normal = normalize(transpose(mat3(object.worldToObject)) * localNormal);
  vec3 localTangent =
      normalize(t0.xyz * w + t1.xyz * u + t2.xyz * v);
  attributes.normal = normal;
  attributes.tangent = normalize(mat3(object.objectToWorld) * localTangent);
  attributes.tangentSign = t0.w * w + t1.w * u + t2.w * v;
  attributes.uv = uv0.xy * w + uv1.xy * u + uv2.xy * v;
  attributes.materialIndex = primitive.materialIndex;
  return true;
}

bool intersectAabb(vec3 origin, vec3 invDir, vec3 bmin, vec3 bmax,
                   float maxT) {
  vec3 t0 = (bmin - origin) * invDir;
  vec3 t1 = (bmax - origin) * invDir;
  vec3 tmin = min(t0, t1);
  vec3 tmax = max(t0, t1);
  float lo = max(max(tmin.x, tmin.y), max(tmin.z, 0.0));
  float hi = min(min(tmax.x, tmax.y), min(tmax.z, maxT));
  return hi >= lo;
}

bool traceScene(vec3 origin, vec3 dir, float maxT, out float hitT,
                out HitAttributes hitAttributes) {
  hitT = maxT;
  hitAttributes.normal = vec3(0.0, 1.0, 0.0);
  hitAttributes.tangent = vec3(1.0, 0.0, 0.0);
  hitAttributes.tangentSign = 1.0;
  hitAttributes.uv = vec2(0.0);
  hitAttributes.materialIndex = 0u;
  bool hit = false;
  vec3 invDir = 1.0 / dir;
  uint stack[64];
  uint stackSize = 0u;
  stack[stackSize++] = 0u;
  while (stackSize > 0u) {
    uint nodeIndex = stack[--stackSize];
    if (nodeIndex >= params.bvhNodeCount) {
      continue;
    }
    lxSceneBvhNode node = bvhNodes[nodeIndex];
    if (!intersectAabb(origin, invDir, node.boundsMinLeftFirst.xyz,
                       node.boundsMaxTriCount.xyz, hitT)) {
      continue;
    }
    uint packedNodeData = floatBitsToUint(node.boundsMaxTriCount.w);
    uint leftFirst = floatBitsToUint(node.boundsMinLeftFirst.w);
    bool isLeaf = (packedNodeData & BVH_LEAF_NODE_FLAG) != 0u;
    if (isLeaf) {
      uint triCount = packedNodeData & ~BVH_LEAF_NODE_FLAG;
      for (uint i = 0u; i < triCount; ++i) {
        uint primitiveIndex = leftFirst + i;
        if (primitiveIndex >= params.primitiveCount) {
          continue;
        }
        float t;
        HitAttributes attributes;
        if (intersectPrimitive(origin, dir, primitives[primitiveIndex], t,
                               attributes) &&
            t < hitT) {
          hit = true;
          hitT = t;
          hitAttributes = attributes;
        }
      }
    } else {
      if (stackSize + 2u < 64u) {
        stack[stackSize++] = packedNodeData;
        stack[stackSize++] = leftFirst;
      }
    }
  }
  return hit;
}

bool hasSceneTexture(uint textureIndex) {
  return textureIndex != INVALID_TEXTURE_INDEX &&
         textureIndex < SCENE_TEXTURE_COUNT;
}

vec4 sampleSceneTexture(uint textureIndex, vec2 uv) {
  return texture(SceneTextures[nonuniformEXT(textureIndex)], uv);
}

vec3 makeShadingNormal(lxSceneMaterialRecord material, HitAttributes hit) {
  vec3 N = normalize(hit.normal);
  if (!hasSceneTexture(material.normalTexture)) {
    return N;
  }

  vec3 T = hit.tangent - N * dot(N, hit.tangent);
  float tangentLength = length(T);
  if (tangentLength < 1.0e-5) {
    return N;
  }
  T = T / tangentLength;
  vec3 B = normalize(cross(N, T) * hit.tangentSign);
  mat3 TBN = mat3(T, B, N);
  vec3 tangentNormal =
      sampleSceneTexture(material.normalTexture, hit.uv).xyz * 2.0 - 1.0;
  return normalize(TBN * tangentNormal);
}

vec3 shade(vec3 origin, vec3 dir) {
  float hitT;
  HitAttributes hit;
  if (!traceScene(origin, dir, 1.0e30, hitT, hit)) {
    if (params.compareMode == 1u) {
      return vec3(0.0);
    }
    return environmentColor(dir);
  }

  lxSceneMaterialRecord material =
      materials[min(hit.materialIndex, params.materialCount - 1u)];
  vec3 baseColor = material.baseColor.rgb;
  if (hasSceneTexture(material.baseColorTexture)) {
    baseColor *= sampleSceneTexture(material.baseColorTexture, hit.uv).rgb;
  }
  if (params.compareMode == 1u) {
    return baseColor;
  }

  vec3 hitPos = origin + dir * hitT;
  vec3 N = makeShadingNormal(material, hit);
  vec3 V = normalize(-dir);
  vec3 L = normalize(-params.lightDirectionIntensity.xyz);

  float shadowT;
  HitAttributes shadowHit;
  bool occluded = params.shadowsEnabled != 0u &&
                  traceScene(hitPos + N * 0.002, L, 1.0e30, shadowT,
                             shadowHit);
  float visibility = occluded ? 0.0 : 1.0;

  LxPbrDirectInput pbrInput;
  pbrInput.baseColor = baseColor;
  pbrInput.normal = N;
  pbrInput.viewDir = V;
  pbrInput.lightDir = L;
  pbrInput.lightColor = params.lightColorEnvironment.rgb *
                        params.lightDirectionIntensity.w * visibility;
  pbrInput.metallic = clamp(material.pbrParams.x, 0.0, 1.0);
  pbrInput.roughness = clamp(material.pbrParams.y, 0.04, 1.0);
  if (hasSceneTexture(material.metallicRoughnessTexture)) {
    vec4 mr =
        sampleSceneTexture(material.metallicRoughnessTexture, hit.uv);
    pbrInput.metallic = clamp(pbrInput.metallic * mr.b, 0.0, 1.0);
    pbrInput.roughness = clamp(pbrInput.roughness * mr.g, 0.04, 1.0);
  }
  pbrInput.ao = clamp(material.pbrParams.w, 0.0, 1.0);
  if (hasSceneTexture(material.aoTexture)) {
    pbrInput.ao =
        clamp(pbrInput.ao * sampleSceneTexture(material.aoTexture, hit.uv).r,
              0.0, 1.0);
  }
  pbrInput.emissive = material.emissive.rgb;
  if (hasSceneTexture(material.emissiveTexture)) {
    pbrInput.emissive =
        sampleSceneTexture(material.emissiveTexture, hit.uv).rgb;
  }
  LxPbrClearcoatInput clearcoat;
  clearcoat.factor = material.clearcoatParams.x;
  clearcoat.roughness = material.clearcoatParams.y;
  return lxPbrLayeredClearcoatDirectLight(pbrInput, clearcoat) +
         lxPbrEmissive(pbrInput);
}

void main() {
  uvec2 gid = gl_GlobalInvocationID.xy;
  if (gid.x >= params.width || gid.y >= params.height) {
    return;
  }
  uint pixelIndex = gid.y * params.width + gid.x;
  vec3 color = vec3(0.0);
  uint sampleCount = max(params.samples, 1u);
  for (uint s = 0u; s < sampleCount; ++s) {
    uint sampleSeed = params.seed ^ (pixelIndex * 9781u) ^ (s * 6271u);
    vec2 jitter = vec2(random01(sampleSeed), random01(sampleSeed ^ 0x9e3779b9u));
    if (sampleCount == 1u) {
      jitter = vec2(0.5);
    }
    vec2 uv = (vec2(gid) + jitter) / vec2(params.width, params.height);
    vec2 ndc = uv * 2.0 - 1.0;
    ndc.y = -ndc.y;
    vec3 rayDir = normalize(params.cameraForward.xyz +
                            params.cameraRight.xyz * ndc.x +
                            params.cameraUp.xyz * ndc.y);
    color += shade(params.eye.xyz, rayDir);
  }
  pixels[pixelIndex] = vec4(color / float(sampleCount), 1.0);
}
