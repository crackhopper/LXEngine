#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform samplerCube BakeEnvironmentCubemap;

void main() {
    vec3 direction = normalize(vec3(0.0, 0.0, 1.0));
    vec3 radiance = texture(BakeEnvironmentCubemap, direction).rgb;
    if (radiance.x < -1.0) {
        return;
    }
}
